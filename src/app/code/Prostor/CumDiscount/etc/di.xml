<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Prostor\CumDiscount\Api\LoyaltySnapshotProviderInterface"
                type="Prostor\CumDiscount\Model\Loyalty\CacheBackedLoyaltySnapshotProvider"/>
    <virtualType name="Prostor\CumDiscount\Logger\LoyaltyLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">prostor_cumdiscount</argument>
            <argument name="handlers" xsi:type="array">
                <item name="prostor_cumdiscount" xsi:type="object">Prostor\CumDiscount\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Prostor\CumDiscount\Model\Loyalty\CacheBackedLoyaltySnapshotProvider">
        <arguments>
            <argument name="logger" xsi:type="object">Prostor\CumDiscount\Logger\LoyaltyLogger</argument>
        </arguments>
    </type>
    <type name="Prostor\CumDiscount\Model\Quote\Address\Total\Cumulative">
        <arguments>
            <argument name="logger" xsi:type="object">Prostor\CumDiscount\Logger\LoyaltyLogger</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="prostor_cumdiscount_seed_demo" xsi:type="object">Prostor\CumDiscount\Console\Command\SeedDemoDataCommand</item>
            </argument>
        </arguments>
    </type>
</config>
