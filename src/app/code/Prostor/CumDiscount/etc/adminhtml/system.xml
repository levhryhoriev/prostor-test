<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="prostor_cumdiscount" translate="label" type="text" sortOrder="950" showInDefault="0"
                 showInWebsite="1" showInStore="0">
            <label>Prostor Cumulative Discount</label>
            <tab>sales</tab>
            <resource>Prostor_CumDiscount::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="0"
                   showInWebsite="1" showInStore="0">
                <label>General Settings</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="base_url" translate="label" type="text" sortOrder="20" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Loyalty Service Base URL</label>
                    <validate>required-entry validate-url</validate>
                </field>
                <field id="token" translate="label" type="obscure" sortOrder="30" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Loyalty Service Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="40" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Request Timeout (Seconds)</label>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                </field>
                <field id="cache_ttl" translate="label" type="text" sortOrder="50" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Cache TTL (Seconds)</label>
                    <validate>required-entry validate-digits validate-digits-range digits-range-1-</validate>
                </field>
                <field id="loyalty_currency" translate="label" type="text" sortOrder="60" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Loyalty Currency</label>
                    <validate>required-entry validate-alphanum</validate>
                </field>
                <field id="thresholds" translate="label" type="text" sortOrder="70" showInDefault="0"
                       showInWebsite="1" showInStore="0">
                    <label>Cumulative Discount Thresholds</label>
                    <frontend_model>Prostor\CumDiscount\Block\Adminhtml\System\Config\Thresholds</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
