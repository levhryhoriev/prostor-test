<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_address" resource="checkout" engine="innodb" comment="Sales Flat Quote Address">
        <column xsi:type="decimal" name="prostor_cumdiscount_amount" nullable="false" scale="4" precision="20"
                default="0.0000" comment="Prostor Cumulative Amount"/>
        <column xsi:type="decimal" name="base_prostor_cumdiscount_amount" nullable="false" scale="4" precision="20"
                default="0.0000" comment="Base Prostor Cumulative Amount"/>
    </table>
</schema>
